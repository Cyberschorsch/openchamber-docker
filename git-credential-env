#!/bin/sh
# Git credential helper: answers from the container environment, so no token
# is ever written to disk. Registered in /etc/gitconfig as "credential.helper=env".
#   GH_TOKEN (or GITHUB_TOKEN)  -> github.com
#   GITLAB_TOKEN                -> $GITLAB_HOST (default gitlab.com)
# Any other host gets no answer and git falls through to its normal behaviour.

[ "$1" = "get" ] || exit 0

host=
while IFS= read -r line; do
  case "$line" in
    host=*) host=${line#host=} ;;
  esac
done

case "$host" in
  github.com|gist.github.com)
    token=${GH_TOKEN:-${GITHUB_TOKEN:-}}
    user=x-access-token
    ;;
  "${GITLAB_HOST:-gitlab.com}")
    token=${GITLAB_TOKEN:-}
    user=oauth2
    ;;
  *)
    exit 0
    ;;
esac

if [ -n "$token" ]; then
  printf 'username=%s\npassword=%s\n' "$user" "$token"
fi
exit 0
